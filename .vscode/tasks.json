{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "subjectSelection",
      "type": "pickString",
      "description": "Seleziona la materia da compilare:",
      "options": [
        "Algorithm-Engineering",
        "Computational-Mathematics",
        "Data-Mining",
        "Information-Retrieval"
      ],
      "default": "Data-Mining"
    },
    {
      "id": "mp4FilePath",
      "type": "promptString",
      "description": "Inserisci il percorso del file .mp4 da convertire in MP3 (mono 64k):"
    }
  ],
  "tasks": [
    {
      "label": "Smart Build (Compila solo modificate)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Scegli Materia da Compilare",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Subject",
        "${input:subjectSelection}",
        "-Force"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Forza Compilazione Totale (Force All)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-All",
        "-Force"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Aggiorna Figure Data-Mining (Python)",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "run",
        "--rm",
        "figures"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Pulisci File Temporanei LaTeX (Clean All)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/clean.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Avvia Jupyter Lab (Docker)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/start-jupyter.ps1"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": false
      }
    },
    {
      "label": "Converti Videolezione MP4 in MP3 (Mono 64k)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/mp4-to-mp3.ps1",
        "${input:mp4FilePath}"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    }
  ]
}
