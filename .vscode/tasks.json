{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "subjectSelection",
      "type": "pickString",
      "description": "Seleziona la materia da compilare:",
      "options": [
        "Algorithm-Engineering",
        "Algorithm-Engineering-II",
        "Computational-Mathematics",
        "Data-Mining",
        "Information-Retrieval"
      ],
      "default": "Data-Mining"
    },
    {
      "id": "mp4FilePath",
      "type": "promptString",
      "description": "Inserisci il percorso del file .mp4 da convertire in MP3 (mono 64k):"
    }
  ],
  "tasks": [
    {
      "label": "Smart Build (Compila solo modificate)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build.ps1"
        ]
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Scegli Materia da Compilare",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "-s",
        "${input:subjectSelection}",
        "-f"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build.ps1",
          "-Subject",
          "${input:subjectSelection}",
          "-Force"
        ]
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py",
          "-s",
          "${input:subjectSelection}",
          "-f"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py",
          "-s",
          "${input:subjectSelection}",
          "-f"
        ]
      },
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Forza Compilazione Totale (Force All)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "-a",
        "-f"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/build.ps1",
          "-All",
          "-Force"
        ]
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py",
          "-a",
          "-f"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/build.py",
          "-a",
          "-f"
        ]
      },
      "group": {
        "kind": "build"
      },
      "problemMatcher": "$tex",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Aggiorna Figure Data-Mining (Python)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/Data-Mining/scripts/generate_dispensa_figures.py"
      ],
      "windows": {
        "command": "docker",
        "args": [
          "compose",
          "run",
          "--rm",
          "figures"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Pulisci File Temporanei LaTeX (Clean All)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/clean.py"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/clean.ps1"
        ]
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/clean.py"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/clean.py"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "Converti Videolezione MP4 in MP3 (Mono 64k)",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/mp4_to_mp3.py",
        "${input:mp4FilePath}"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/mp4-to-mp3.ps1",
          "${input:mp4FilePath}"
        ]
      },
      "linux": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/mp4_to_mp3.py",
          "${input:mp4FilePath}"
        ]
      },
      "osx": {
        "command": "python3",
        "args": [
          "${workspaceFolder}/scripts/mp4_to_mp3.py",
          "${input:mp4FilePath}"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    }
  ]
}