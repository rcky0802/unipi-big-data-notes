{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "docker-build-smart",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ]
    },
    {
      "name": "docker-build-force",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Force"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Docker Smart Build",
      "tools": [
        "docker-build-smart"
      ]
    },
    {
      "name": "Docker Force Build",
      "tools": [
        "docker-build-force"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "never"
}
