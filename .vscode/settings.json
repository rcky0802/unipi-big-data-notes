{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "smart-build",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py"
      ]
    },
    {
      "name": "smart-build-force",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/build.py",
        "--force"
      ]
    },
    {
      "name": "docker-build-smart",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1"
      ]
    },
    {
      "name": "docker-build-force",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Force"
      ]
    },
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-emulate-aux-dir",
        "-auxdir=build",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Smart Build (Python)",
      "tools": [
        "smart-build"
      ]
    },
    {
      "name": "Docker Smart Build (PowerShell)",
      "tools": [
        "docker-build-smart"
      ]
    },
    {
      "name": "latexmk (Diretto)",
      "tools": [
        "latexmk"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "never"
}