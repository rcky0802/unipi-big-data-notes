# Impostazioni di fine riga standard
* text=auto eol=lf

# File script per ambienti Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Documenti e file sorgente
*.tex text diff=tex
*.bib text
*.md text
*.json text

# File binari
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
