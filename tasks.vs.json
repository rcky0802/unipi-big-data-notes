{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Smart Build (Compila solo modificate IT + EN)",
      "appliesTo": "/",
      "type": "launch",
      "contextType": "build",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Compila solo Italiano (IT)",
      "appliesTo": "/",
      "type": "launch",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1",
        "-Lang",
        "IT"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Compila solo Inglese (EN)",
      "appliesTo": "/",
      "type": "launch",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1",
        "-Lang",
        "EN"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Forza Compilazione Totale (Force All)",
      "appliesTo": "/",
      "type": "launch",
      "contextType": "rebuild",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1",
        "-All",
        "-Force"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Pulisci File Temporanei LaTeX (Clean All)",
      "appliesTo": "/",
      "type": "launch",
      "contextType": "clean",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\clean.ps1"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Compila materia selezionata (cartella)",
      "appliesTo": "*/",
      "type": "launch",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1",
        "-Subject",
        "${fileBasename}",
        "-Force"
      ],
      "workingDirectory": "${workspaceRoot}"
    },
    {
      "taskLabel": "Compila (menu interattivo)",
      "appliesTo": "scripts/build.ps1",
      "type": "launch",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceRoot}\\scripts\\build.ps1",
        "-Interactive"
      ],
      "workingDirectory": "${workspaceRoot}"
    }
  ]
}
