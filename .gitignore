# ==============================================================================
# File temporanei e artefatti di compilazione LaTeX
# ==============================================================================
build/
**/build/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.out
*.run.xml
*.synctex
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
*.xdv

# ==============================================================================
# Gestione dei file PDF
# ==============================================================================
# Ignora i PDF locali generati nelle singole cartelle materia (es. main.pdf)
*.pdf

# Mantieni traccia delle figure vettoriali/grafici in formato PDF
!assets/*.pdf
!assets/**/*.pdf

# Mantieni traccia dei PDF finali distribuiti nella cartella centrale pdf/
!pdf/*.pdf

# ==============================================================================
# File di sistema e configurazioni editor
# ==============================================================================
.idea/
.DS_Store
__MACOSX/
Thumbs.db

# Mantieni le cartelle vscode e tasks/settings
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json

# Soluzione Visual Studio locale (non versionata, per compatibilita' con VS Code)
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/

# Istruzioni Copilot locali (non versionate)
.github/copilot-instructions.md

# ==============================================================================
# Python environments, bytecode & Jupyter
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
notebooks/output/
**/notebooks/output/
scratch/
